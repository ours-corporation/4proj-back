HOST=0.0.0.0
PORT=3000

# Origines autorisées pour CORS et WebSocket (séparées par des virgules)
APP_URL="http://localhost:5555,http://localhost:3000"

JWT_SECRET="jwt_secret_example"
REFRESH_SECRET="refresh_secret_example"

DB_CLIENT="postgres"
DB_HOST="db_postgres"
DB_PORT=5432
DB_USER="superfile_user"
DB_PASSWORD="password"
DB_NAME="supfile"

DATABASE_URL="postgresql://superfile_user:password@db_postgres:5432/supfile"

# Mail (MailPit en dev)
SMTP_HOST="mailpit_dev"
SMTP_PORT=1025
# SMTP_USER et SMTP_PASS non requis en dev (MailPit accepte sans auth)
# En prod avec Brevo : SMTP_HOST=smtp-relay.brevo.com, SMTP_PORT=587
SMTP_USER=""
SMTP_PASS=""
MAIL_FROM="noreply@supfile.local"

# URL publique du backend (utilisée comme redirect_uri pour les callbacks OAuth GitHub)
BACKEND_URL="http://localhost:3001"
FRONTEND_URL="http://localhost:3000"

# OAuth Google
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# OAuth GitHub
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""
